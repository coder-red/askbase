# BaseChatt environment configuration.
# Copy to .env and adjust for your machine. NEVER commit .env ΓÇö only .env.example.
# Every key is prefixed with BASECHATT_ (see src/basechatt/config/settings.py).

# ---- App ----
BASECHATT_DEBUG=false
BASECHATT_ENVIRONMENT=development

# ---- LLM provider (default: Groq, fast & free-tier) ----
# Supported: groq | openai | anthropic | mock  (mock = offline, for tests)
BASECHATT_LLM_PROVIDER=groq
BASECHATT_GROQ_API_KEY=
BASECHATT_GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# BASECHATT_OPENAI_API_KEY=
# BASECHATT_ANTHROPIC_API_KEY=
BASECHATT_LLM_TEMPERATURE=0.2
BASECHATT_LLM_MAX_TOKENS=2048

# ---- Embeddings (via provider API, $0 free tier) ----
BASECHATT_EMBEDDING_MODEL=nomic-embed-text-v1.5
BASECHATT_EMBEDDING_DIM=768
BASECHATT_EMBEDDING_BATCH_SIZE=32

# ---- Reranker strategy: deterministic (no LLM) | llm ----
BASECHATT_RERANKER_STRATEGY=deterministic

# ---- Database (PostgreSQL + pgvector). The --db-up target maps host:5433 -> container:5432 ----
BASECHATT_DATABASE_URL=postgresql+asyncpg://basechatt:basechatt@localhost:5433/basechatt

# ---- Redis (used for embedding cache + rate limiting). host:6380 -> container:6379 ----
BASECHATT_REDIS_URL=redis://localhost:6380/0
BASECHATT_USE_REDIS=true

# ---- Security ----
# Leave blank for open (dev) access. Set a random value for production.
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BASECHATT_API_KEY=
BASECHATT_RATE_LIMIT_PER_MINUTE=60

# ---- Paths (overrides are relative to the project root) ----
# BASECHATT_DATA_DIR=./data
# BASECHATT_COMPANIES_CONFIG=./config/companies.yaml
